# 生产环境变量。用法：
#   cp .env.production.example .env
#   # 填好下面每一项，然后
#   docker compose -f compose.prod.yaml up -d --build
#   ./deploy/init-letsencrypt.sh
#
# ⚠️ 这个文件（.env）**不要提交**。仓库里只留这份 example。
#
# ⚠️ 这里是**单站**配置：一台机器 = 一个站点 = 一个域名 = 一套库。
#    多站不是把这段配置复制到同一台机器，而是各自独立的部署单元（定位「产品要求 1」）。
#    每接一个新站，需要改的是：SITE_KEY / DOMAIN / OTAKU_PUBLIC_BASE_URL / 三个口令。

# ── 站点标识 ────────────────────────────────────────────
# 站点键，用于运维产物命名（备份文件、巡检日志）。一台机器上不要与别的站重复。
SITE_KEY=otaku

# ── 数据库 ──────────────────────────────────────────────
DB_NAME=otaku
DB_USER=otaku
# 生成方式：openssl rand -base64 24
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ── 后端 ────────────────────────────────────────────────
# Python 同步作业调 /internal/import/** 时用的令牌，必须与 sync-python 侧一致。
# 生成方式：openssl rand -base64 32
# 留空的话 /internal/** 会全部返回 401（安全默认），但那也意味着同步进不来。
OTAKU_INTERNAL_TOKEN=

# 后端对外的完整地址，客户端拿到的 cover_url 用它拼。
# **必须是该站的对外地址，且带协议**：上了 HTTPS 就写 https://<DOMAIN>。
# 前面挂了 Nginx / 反代时**必须**设，否则推导出来的封面地址可能是 localhost。
OTAKU_PUBLIC_BASE_URL=https://otaku.example.com

# ── 对外开放策略（Issue #188，zm 2026-10-26 拍板 A）────────
# 允许跨域读 /api/** 的页面来源（逗号分隔，origin 形式）。**留空 = 只放行本地调试来源**。
# 必须列出站点自己的 origin，否则站点页面读接口会被 CORS 403。
OTAKU_CORS_ALLOWED_ORIGINS=http://otaku.example.com
# 公共读按 IP 限流（每分钟）。现在没有站点身份，按 IP 是唯一能挡住脚本刷图床的手段。
OTAKU_RATE_LIMIT_PUBLIC_PER_MINUTE=600
# 封面更严：它会回源并缓存，被当图床的代价是带宽 + 回源
OTAKU_RATE_LIMIT_COVER_PER_MINUTE=240
# 上了 Nginx/反代之后**必须**改为 true，否则所有请求都算到反代 IP 上（限流退化成全局限流）。
OTAKU_TRUST_FORWARDED_FOR=false
# 封面防盗链：允许引用封面的来源页 origin（逗号分隔）。**留空 = 不限制**（#189 的开关）。
# 打开后：不带 Referer 的请求（Flutter / curl / 服务端）仍放行，只有别站页面带 Referer 取图才拒（404）。
OTAKU_COVER_ALLOWED_REFERERS=http://otaku.example.com:8000

# 后端默认只监听本机回环（127.0.0.1），公网流量一律经 Nginx。
# 需要在别的机器上直连 :8080 调试，改成 0.0.0.0，并在防火墙里限定来源 IP。
BACKEND_BIND=127.0.0.1
BACKEND_PORT=8080

# ── 域名与 HTTPS ────────────────────────────────────────
# 必填：证书路径、server_name、证书到期检查都用它。
# 每站**独立域名**——共用域名就没法给每个站单独签证书，而证书是 HTTPS 的前提。
DOMAIN=otaku.example.com
# Let's Encrypt 到期通知邮箱。
LETSENCRYPT_EMAIL=ops@example.com

# ── 备份 ────────────────────────────────────────────────
# 备份落盘目录（宿主机路径）。确认它在数据盘而不是系统盘。
BACKUP_DIR=/var/backups/otaku
# 保留天数。按每天一备 + 单份 100 MB 量级估算，14 天约 1.5 GB。
BACKUP_RETAIN_DAYS=14

# ── 资源 ────────────────────────────────────────────────
# 2G 内存的机器用 128M～256M；4G 以上可以调到 512M～1G。
# 这个值直接决定 MySQL 常驻内存，调大之前先看 `free -m`。
MYSQL_BUFFER_POOL=256M

# 容器内存上限（上限，不是预留）。2 核 2 GB 且同机还有别的服务时，
# 不设这一项 MySQL 会按宿主机内存自算，和 JVM 抢到整机 OOM。
MYSQL_MEM_LIMIT=768m
BACKEND_MEM_LIMIT=768m

# 镜像构建方式：能用服务器编就留 Dockerfile（默认）。
# 小机器建议本地 `./mvnw package` 出 jar 后改成 Dockerfile.runtime，几秒组装完。
BACKEND_DOCKERFILE=Dockerfile

TZ=Asia/Shanghai

# ── 上线前（还没有域名）的临时形态 ──────────────────────
# 域名归商务侧、上线阶段再谈；在那之前用「IP + HTTP 直连 :8080」把功能跑通：
#   BACKEND_BIND=0.0.0.0
#   OTAKU_PUBLIC_BASE_URL=http://<IP>:8080
#   DOMAIN=<IP>            # 只为满足 compose 的必填校验，nginx 不启动
# 起服务时**不要带 nginx**：`docker compose -f compose.prod.yaml up -d mysql backend`
# （机器上 80 端口已被别的站占用，而且没有域名签不了证书。）
# 巡检也要跟着改期望，否则每天报「容器 otaku-nginx 不存在」和「取不到证书」：
#   EXPECT_SERVICES="otaku-backend otaku-mysql"
#   EXPECT_TLS=0
# ⚠️ 这个形态没有 HTTPS，Android release 包连不上，只用于联调阶段。
# 正式上线必须切回「域名 + nginx + 证书」，见 docs/deploy-production.md §4.6。
