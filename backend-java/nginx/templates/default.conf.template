# 单站生产 server 块。
#
# 这个文件是 **template**，不是普通 conf：官方 nginx 镜像的 entrypoint 会在启动前
# 用 envsubst 把 ${DOMAIN} / ${BACKEND_UPSTREAM} 替换成 .env 里的值，
# 输出到 /etc/nginx/conf.d/default.conf。所以这里出现 ${...} 是**故意的**。
# （Nginx 自己的变量是 $host / $remote_addr 这种不带花括号的写法，envsubst 不会动它们。）
#
# 域名没配就直接起不来，这是有意的：宁可启动失败，也不要拿一个错域名签出证书。

# ── :80 只做两件事：ACME 验证 + 跳 HTTPS ──────────────────────────────
server {
    listen      80;
    listen      [::]:80;
    server_name ${DOMAIN};

    # certbot --webroot 会往这个目录写验证文件；必须在跳转之前匹配，
    # 否则证书续期会被 301 到 https —— 而 https 用的正是要续的那张证书。
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # 容器健康检查用。exact match 优先级高于下面的 / 跳转。
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── :443 反代到后端 ───────────────────────────────────────────────────
server {
    listen      443 ssl;
    listen      [::]:443 ssl;
    http2       on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    # 只留 1.2 / 1.3。TLS 1.0/1.1 已被所有主流客户端弃用，留着只是扩大攻击面。
    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache         shared:SSL:10m;
    ssl_session_timeout       1d;
    ssl_session_tickets       off;

    # HSTS 先不开：一旦浏览器记住，回退到 HTTP 会让站点直接不可达。
    # 等证书续期跑通、域名稳定后再取消下面这行注释（见 README §6）。
    # add_header Strict-Transport-Security "max-age=31536000" always;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # 封面首次回源实测可达 16s+（docs/w4-second-site-report.md），
    # 默认 60s 够用，但单独放宽到 120s，避免首屏偶发 504。
    location /api/covers/ {
        proxy_pass http://${BACKEND_UPSTREAM};

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  $server_port;
        proxy_set_header Connection        "";

        proxy_connect_timeout 5s;
        proxy_send_timeout    30s;
        proxy_read_timeout    120s;

        # 关掉缓冲：封面是几十 KB 的二进制，Nginx 先落盘再转发没有收益，
        # 反而多一次磁盘写（2 核 2G 的机器上磁盘 IO 比内存紧张）。
        proxy_buffering off;
    }

    # ── 客户端安装包 / 更新清单 ───────────────────────────────────────
    # 目录由 compose 挂载（backend-java/downloads → /usr/share/nginx/downloads）。
    # 清单必须 no-store：客户端每次启动都要拿到最新版本号；APK 可以长缓存。
    location = /downloads/latest.json {
        alias /usr/share/nginx/downloads/latest.json;
        default_type application/json;
        add_header Cache-Control "no-store" always;
        access_log off;
    }

    location /downloads/ {
        alias /usr/share/nginx/downloads/;
        # 不让目录可浏览：只有知道具体文件名的人能取。
        autoindex off;
        # APK 文件名带版本号，内容不会变，可以放心长缓存。
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        default_type application/octet-stream;
    }

    location / {
        proxy_pass http://${BACKEND_UPSTREAM};

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  $server_port;
        # 空 Connection 才会走后端 keepalive；不写这行每请求都会新建连接。
        proxy_set_header Connection        "";

        proxy_connect_timeout 5s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;

        proxy_buffering on;
        proxy_buffers       16 16k;
        proxy_busy_buffers_size 32k;
    }

    # 内部导入接口不该从公网进来。后端有 token 校验，这里是**纵深防御**：
    # 少一层暴露面，就少一种「token 泄露之后」的可能性。
    location /internal/ {
        return 404;
    }

    # 健康检查对外只留 /actuator/health（生产已设 show-details=never，只返回 status）。
    # 其余 actuator 端点（env / beans / metrics）一律不对外。
    location = /actuator/health {
        proxy_pass http://${BACKEND_UPSTREAM};
        proxy_set_header Host $host;
        access_log off;
    }

    location /actuator/ {
        return 404;
    }

    # ── 限流（默认关闭）──────────────────────────────────────────────
    # 启用前先读 nginx.conf 里那两个 zone 的注释：命中会返回 429，
    # 而 429 不在契约错误码表里。开了就等于对外多一种状态码。
    #
    # limit_req zone=api burst=40 nodelay;
    # limit_req_status 429;
}
