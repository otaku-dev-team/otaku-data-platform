{
  "dataset_version": "2",
  "source_id": "otaku",
  "_notes": [
    "Otaku 网站（FastAPI + SQLite）→ 标准数据集 v2 的映射。",
    "改客户表只改本文件，不动代码——这是解耦的落点。",
    "on_missing 三档：break=关键列缺失就停机 / reject=该行拒绝 / degrade=置空继续。",
    "source_id、关联表的 content_id 一律 break：主键错了会静默产生几十万条重复脏数据。",
    "contents 表没有 updated_at，故 works.source_updated_at 不映射（保持 NULL）。",
    "需要增量同步时，源侧必须补 updated_at 列或触发器；否则只能全量重扫或内容哈希比对。",
    "articles 用 filter 只取已发布，未审核草稿不进数据集。",
    "v2：work_credits 从「整表照搬」改成按 role 白名单过滤——源表 407,949 条里 91% 是原画等工序流水，详情页用不上。白名单与黑名单都写在本文件的 SQL 里，改词表不用改代码、不用发版。",
    "v2：新增 people 表（源 entities），credits / cast 的 person_ref 指向它。没有实体的人名（Staff 侧大量如此）不进这张表，person_ref 留空。"
  ],
  "tables": [
    {
      "target": "works",
      "mode": "table",
      "source": "contents",
      "key": "id",
      "fields": [
        {"target": "source_id", "column": "id", "type": "str", "required": true, "on_missing": "break"},
        {"target": "work_type", "column": "type", "type": "enum", "required": true, "on_missing": "reject",
         "enum_map": {
           "动画": "anime", "漫画": "comic", "游戏": "game", "轻小说": "novel",
           "anime": "anime", "comic": "comic", "game": "game", "novel": "novel"
         }},
        {"target": "title", "column": "title", "type": "str", "required": true, "on_missing": "reject"},
        {"target": "summary", "column": "summary", "type": "text"},
        {"target": "cover_url", "column": "image_url", "type": "str"},
        {"target": "release_year", "column": "year", "type": "int", "min": 1900, "max": 2100},
        {"target": "rating_value", "column": "rating", "type": "float", "min": 0, "max": 10},
        {"target": "rating_scale", "const": "0-10", "type": "str"},
        {"target": "source_url", "column": "source_url", "type": "str"},
        {"target": "title_original", "column": "title_original", "type": "str"},
        {"target": "summary_original", "column": "summary_original", "type": "text"},
        {"target": "aliases_json", "column": "aliases", "type": "bracket_list"},
        {"target": "rating_count", "column": "rating_count", "type": "int", "min": 0},
        {"target": "media", "column": "media", "type": "str"},
        {"target": "episodes", "column": "episodes", "type": "int", "min": 0, "max": 10000},
        {"target": "source_material", "column": "source_material", "type": "str"},
        {"target": "series_key", "column": "series_id", "type": "str"}
      ]
    },
    {
      "target": "work_tags",
      "mode": "query",
      "required_sources": ["content_tags", "tags"],
      "sql": "select ct.content_id as source_id, t.name as name from content_tags ct join tags t on t.id = ct.tag_id"
    },
    {
      "target": "work_facts",
      "mode": "table",
      "source": "content_facts",
      "key": "content_id",
      "fields": [
        {"target": "source_id", "column": "content_id", "type": "str", "required": true, "on_missing": "break"},
        {"target": "key", "column": "key", "type": "str", "required": true, "on_missing": "reject"},
        {"target": "value", "column": "value", "type": "str", "required": true, "on_missing": "reject"}
      ]
    },
    {
      "target": "people",
      "mode": "table",
      "source": "entities",
      "key": "id",
      "fields": [
        {"target": "source_id", "column": "id", "type": "str", "required": true, "on_missing": "break"},
        {"target": "name", "column": "name", "type": "str", "required": true, "on_missing": "reject"},
        {"target": "entity_type", "column": "entity_type", "type": "str"},
        {"target": "bangumi_person_id", "column": "bangumi_person_id", "type": "str"}
      ]
    },
    {
      "target": "work_credits",
      "mode": "query",
      "required_sources": ["content_credits"],
      "sql": "select cast(content_id as text) as source_id, role, name, cast(person_id as text) as person_ref, tier, sort_order from content_credits where (tier = 'main' and role not like '版本:%' and role not in ('发售日','作者','连载杂志','ISBN-10','ISBN-13','册数','链接','出版社','开始','结束','页数','价格','装帧','尺寸')) or role in ('作画监督','总作画监督','演出','分镜','机械作画监督','动作作画监督') order by content_id, sort_order"
    },
    {
      "target": "work_cast",
      "mode": "table",
      "source": "content_cast",
      "key": "content_id",
      "fields": [
        {"target": "source_id", "column": "content_id", "type": "str", "required": true, "on_missing": "break"},
        {"target": "character", "column": "character", "type": "str", "required": true, "on_missing": "reject"},
        {"target": "actor", "column": "actor", "type": "str", "required": true, "on_missing": "reject"},
        {"target": "person_ref", "column": "person_id", "type": "str"},
        {"target": "relation", "column": "relation", "type": "str"},
        {"target": "sort_order", "column": "sort_order", "type": "int"}
      ]
    },
    {
      "target": "work_studios",
      "mode": "table",
      "source": "content_studios",
      "key": "content_id",
      "fields": [
        {"target": "source_id", "column": "content_id", "type": "str", "required": true, "on_missing": "break"},
        {"target": "name", "column": "name", "type": "str", "required": true, "on_missing": "reject"}
      ]
    },
    {
      "target": "work_relations",
      "mode": "query",
      "required_sources": ["content_relations"],
      "sql": "select from_content_id as source_id, to_content_id as related_source_id, relation_type as relation from content_relations"
    },
    {
      "target": "series",
      "mode": "table",
      "source": "series",
      "key": "id",
      "fields": [
        {"target": "series_key", "column": "id", "type": "str", "required": true, "on_missing": "reject"},
        {"target": "name", "column": "name", "type": "str", "required": true, "on_missing": "reject"}
      ]
    },
    {
      "target": "tags",
      "mode": "table",
      "source": "tags",
      "key": "name",
      "fields": [
        {"target": "name", "column": "name", "type": "str", "required": true, "on_missing": "reject"}
      ]
    },
    {
      "target": "articles",
      "mode": "table",
      "source": "articles",
      "key": "id",
      "filter": "is_published = 1",
      "fields": [
        {"target": "source_id", "column": "id", "type": "str", "required": true, "on_missing": "break"},
        {"target": "title", "column": "title", "type": "str", "required": true, "on_missing": "reject"},
        {"target": "summary", "column": "summary", "type": "text"},
        {"target": "body", "column": "body", "type": "text"},
        {"target": "category", "column": "category", "type": "str"},
        {"target": "subcategory", "column": "subcategory", "type": "str"},
        {"target": "event_type", "column": "event_type", "type": "str"},
        {"target": "published_at", "column": "published_at", "type": "datetime"},
        {"target": "source_name", "column": "source", "type": "str"},
        {"target": "source_url", "column": "original_url", "type": "str"},
        {"target": "cover_url", "column": "image_url", "type": "str"},
        {"target": "is_adult", "column": "is_adult", "type": "bool"},
        {"target": "source_updated_at", "column": "updated_at", "type": "datetime"}
      ]
    },
    {
      "target": "article_links",
      "mode": "query",
      "required_sources": ["article_content_links"],
      "sql": "select article_id as article_source_id, content_id as work_source_id from article_content_links"
    },
    {
      "target": "schedules",
      "mode": "table",
      "source": "anime_schedules",
      "key": "id",
      "fields": [
        {"target": "source_id", "column": "id", "type": "str", "required": true, "on_missing": "break"},
        {"target": "season_code", "column": "season_code", "type": "str"},
        {"target": "title_main", "column": "title_main", "type": "str"},
        {"target": "title_cn", "column": "title_cn", "type": "str"},
        {"target": "title_jp", "column": "title_jp", "type": "str"},
        {"target": "weekday", "column": "weekday", "type": "int", "min": 1, "max": 7},
        {"target": "broadcast_time", "column": "broadcast_time", "type": "str"},
        {"target": "broadcast_note", "column": "broadcast_note", "type": "str"},
        {"target": "air_date", "column": "air_date", "type": "str"},
        {"target": "box_office", "column": "box_office", "type": "str"},
        {"target": "work_type", "column": "work_type", "type": "str"},
        {"target": "work_tags_json", "column": "work_tags", "type": "str"},
        {"target": "image_url", "column": "image_url", "type": "str"},
        {"target": "platforms_json", "column": "platforms", "type": "json_list"},
        {"target": "source_url", "column": "source_url", "type": "str"},
        {"target": "content_source_id", "column": "content_id", "type": "str"},
        {"target": "source_updated_at", "column": "last_synced_at", "type": "datetime"}
      ]
    }
  ]
}
