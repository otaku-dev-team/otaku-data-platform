<?xml version="1.0" encoding="utf-8"?>
<!-- 仅 debug 变体生效，覆盖 main 里的同名资源。

     main 那份只放行来源站 154.8.194.198，连本地后端会被 Android 9+ 的明文
     策略拦掉。联调要连的是宿主机，两种方式：

     1) 模拟器：连 10.0.2.2（AppConfig 已按平台切到它），下面已放行。
     2) 真机：**本文件没有放行任何局域网 IP**，因为每台开发机的网段都不同，
        把某个人的 192.168.x.x 写进仓库对别人没用。

        真机联调推荐走 USB 反向转发，不需要改这里：
            adb reverse tcp:8080 tcp:8080
            flutter run -d <设备> --dart-define=API_BASE_URL=http://127.0.0.1:8080
        手机侧访问 127.0.0.1:8080 会经 USB 转到宿主机，下面已放行 127.0.0.1。

        如果一定要走局域网 IP，需要自己把这台机器的 IP 加进下面的名单，
        否则会被明文策略拦掉，报错看起来像「后端挂了」。

     不开 `base-config cleartextTrafficPermitted="true"`：那等于对所有主机放行，
     debug 包虽然不发版，但一旦有人拿 debug 包做安全扫描，结论会很难解释。
     列名单的代价只是多写几行。
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Android 模拟器映射到宿主机的 127.0.0.1 -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <!-- 真机的 adb reverse 走这里 -->
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- 来源站，与 main 保持一致 -->
        <domain includeSubdomains="false">154.8.194.198</domain>
    </domain-config>
</network-security-config>
