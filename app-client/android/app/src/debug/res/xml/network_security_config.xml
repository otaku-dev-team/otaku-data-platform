<?xml version="1.0" encoding="utf-8"?>
<!-- 仅 debug 变体生效，覆盖 main 里的同名资源。

     main 那份只放行来源站 154.8.194.198，连本地后端会被 Android 9+ 的明文
     策略拦掉。联调要连的是宿主机：模拟器用 10.0.2.2（AppConfig 已按平台切换），
     真机走局域网 IP，这里一并放行。

     不开 `base-config cleartextTrafficPermitted="true"`：那等于对所有主机放行，
     debug 包虽然不发版，但一旦有人拿 debug 包做安全扫描，结论会很难解释。
     列名单的代价只是多写几行。
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Android 模拟器映射到宿主机的 127.0.0.1 -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- 来源站，与 main 保持一致 -->
        <domain includeSubdomains="false">154.8.194.198</domain>
    </domain-config>
</network-security-config>
